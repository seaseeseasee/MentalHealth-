# Host port for the web app (8080, 8081, 8090 and 8380 are already used on this machine)
MINDEASE_PORT=8480
# 127.0.0.1 = this machine only; 0.0.0.0 = reachable from the network
MINDEASE_BIND=127.0.0.1
# Set to true when served over HTTPS
COOKIE_SECURE=false
# E-mails that get the admin dashboard (comma separated). They must register normally first or afterwards.
ADMIN_EMAILS=
